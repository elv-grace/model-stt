# Speaker diarization, off unless DIARIZATION=build. It is a Rust crate over
# speakrs (see diarize/), needing a toolchain no other stage wants, so it is
# built apart and the runtime image takes the binary and the ONNX Runtime shared
# libraries without the ~1.5 GB that produced them.
#
# Both variants leave the same two directories behind, so the COPY into the
# runtime stage does not have to know which one ran. Selected by name --
# `--build-arg DIARIZATION=build` -- rather than by a truthiness test, because
# "0" is a non-empty string and every shell-style test here gets that wrong.
ARG DIARIZATION=none

FROM rust:1.88-slim AS diarize-build
# pkg-config and libssl-dev are for openssl-sys, which speakrs' `online` feature
# pulls in through hf-hub's native-tls. That feature is only reached when
# diarization.models_dir is null; the shipped config stages the bundle instead,
# but the code path has to compile either way.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gcc g++ make pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY diarize/ ./diarize/
# DIARIZE_CACHE is where build.sh stages onnxruntime-gpu; a fixed path keeps the
# COPY below independent of $HOME
RUN DIARIZE_CACHE=/opt/diarize ./diarize/build.sh \
    && mkdir -p /opt/diarize/bin \
    && cp diarize/target/release/stt-diarize /opt/diarize/bin/

FROM continuumio/miniconda3:latest AS diarize-none
RUN mkdir -p /opt/diarize/bin /opt/diarize/onnxruntime

FROM diarize-${DIARIZATION} AS diarize

# main STT
FROM continuumio/miniconda3:latest
WORKDIR /elv

RUN conda create -n mlpod python=3.11 -y

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# which backends to install: "ct2" is production, "all" adds openai-whisper and
# the benchmark deps. torch is no longer selected by this -- punctuation
# restoration puts it in install_requires, so every build has it; see
# PUNCTUATION in setup.py.
ARG EXTRAS=ct2

COPY setup.py .
RUN mkdir -p src && /opt/conda/envs/mlpod/bin/pip install --no-cache-dir ".[${EXTRAS}]"

# ctranslate2 loads cuBLAS/cuDNN from the pip nvidia wheels rather than a system
# CUDA install, so they have to be on the loader path explicitly
ENV LD_LIBRARY_PATH=/opt/conda/envs/mlpod/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/conda/envs/mlpod/lib/python3.11/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}

# staged by build.sh; empty when WEIGHTS=none
COPY models ./models

# set to the baked weight root, or left empty so config.yml's ~/.cache path
# applies and the cache is expected as a mount
ARG WEIGHTS_DIR=""
ENV WEIGHTS_DIR=${WEIGHTS_DIR}

# Empty when DIARIZATION=none, in which case config.yml's diarization.binary
# points at nothing and build_diarizer degrades to no speakers -- which is also
# what the shipped config asks for, since diarization defaults to disabled.
COPY --from=diarize /opt/diarize /opt/diarize

# ORT's CUDA execution provider dlopens the same cuBLAS/cuDNN wheels CTranslate2
# does, so it needs no path of its own; only libonnxruntime.so is extra.
ENV LD_LIBRARY_PATH=/opt/diarize/onnxruntime:${LD_LIBRARY_PATH}
ENV ORT_DYLIB_PATH=/opt/diarize/onnxruntime/libonnxruntime.so
ENV DIARIZE_BINARY=/opt/diarize/bin/stt-diarize

COPY src ./src
COPY config.yml config.py run.py download_weights.py ./

ENTRYPOINT ["/opt/conda/envs/mlpod/bin/python", "-u", "run.py"]
